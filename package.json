{
  "name": "dsh-bundle-screen-view",
  "displayName": "桌面操控",
  "description": "Optional DSH bundle that gives the Host desktop tools: window_list and screenshot (read-only), plus window_activate, mouse_click, type_text, key and scroll for driving the real mouse and keyboard — with safety gates, an opt-in per-action consent prompt (allow once / allow for this session / deny), and a settings card in the Plugins page.",
  "version": "1.3.1",
  "private": true,
  "icon": "./icon.svg",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/capture.js",
    "lib/input.js",
    "lib/png.js",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/capture.js && node --check lib/input.js && node --check lib/png.js",
    "test": "node test-host.mjs && node test-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh-bundle",
    "screen-capture",
    "screenshot",
    "desktop-automation",
    "consent",
    "permission",
    "win32"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "os": [
    "win32"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OraSkyC/dsh-bundle-screen-view.git"
  },
  "homepage": "https://github.com/OraSkyC/dsh-bundle-screen-view#readme",
  "bugs": {
    "url": "https://github.com/OraSkyC/dsh-bundle-screen-view/issues"
  },
  "license": "MIT"
}
